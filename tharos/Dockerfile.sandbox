FROM python:3.12-slim

WORKDIR /sandbox

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir uv && uv sync --frozen --group dev

COPY src/ src/
COPY tests/ tests/

ENTRYPOINT ["pytest"]
